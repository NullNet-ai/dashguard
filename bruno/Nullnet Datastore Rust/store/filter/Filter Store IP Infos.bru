meta {
  name: Filter Store IP Infos
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/store/root/ip_infos/filter
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..1fj4-_crBRpQp8Tkwdp93zVW3i8R5nIbYP76Y7vRVd8
}

body:json {
  {
    "pluck": [
      "ip",
      "country"
    ],
    "pluck_object": {},
    "pluck_group_object": {},
    "advance_filters": [
      {
        "type": "criteria",
        "field": "ip",
        "operator": "equal",
        "values": [
          "34.36.31.173"
        ]
      },
      {
        "type": "operator",
        "operator": "and"
      },
      {
        "type": "criteria",
        "field": "country",
        "operator": "equal",
        "values": [
          "US"
        ]
      }
    ],
    "offset": 0,
    "limit": 1,
    "joins": [],
    "order_direction": "desc",
    "order_by": "ip_infos.ip",
    "is_case_sensitive_sorting": false,
    "multiple_sort": [],
    "date_format": "mm/dd/YYYY",
    "concatenate_fields": [],
    "group_advance_filters": [],
    "distinct_by": "",
    "time_format": "HH24:MI"
  }
}

vars:pre-request {
  baseUrl: https://store.appguard.ai
}

settings {
  encodeUrl: true
  timeout: 0
}
