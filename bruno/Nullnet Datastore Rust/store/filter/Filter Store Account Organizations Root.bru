meta {
  name: Filter Store Account Organizations Root
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/store/root/account_organizations/filter
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..tW2VJuytBtxqd38Hpy3ID6GNijAIc9mbdOb7u5PYpAw
}

body:json {
  {
    "pluck": [
      "id"
    ],
    "pluck_object": {
      "account_organizations": [
        "id",
        "organization_id",
        "account_id",
        "contact_id",
        "status"
      ],
      "contacts": [
        "id",
        "first_name",
        "last_name"
      ],
      "organizations": [
        "name",
        "id"
      ],
      "user_roles": [
        "role",
        "id"
      ]
    },
    "pluck_group_object": {},
    "advance_filters": [
      {
        "type": "criteria",
        "field": "email",
        "operator": "equal",
        "values": [
          "admin@dnamicro.com"
        ]
      }
    ],
    "offset": 0,
    "limit": 10,
    "joins": [
      {
        "type": "left",
        "field_relation": {
          "to": {
            "entity": "contacts",
            "field": "id"
          },
          "from": {
            "entity": "account_organizations",
            "field": "contact_id"
          }
        },
        "nested": false
      },
      {
        "type": "left",
        "field_relation": {
          "to": {
            "entity": "organizations",
            "field": "id"
          },
          "from": {
            "entity": "account_organizations",
            "field": "organization_id"
          }
        },
        "nested": false
      },
      {
        "type": "left",
        "field_relation": {
          "to": {
            "entity": "user_roles",
            "field": "id"
          },
          "from": {
            "entity": "account_organizations",
            "field": "role_id"
          }
        },
        "nested": false
      }
    ],
    "is_case_sensitive_sorting": false,
    "multiple_sort": [],
    "date_format": "mm/dd/YYYY",
    "concatenate_fields": [],
    "group_advance_filters": [],
    "distinct_by": "",
    "time_format": "HH24:MI"
  }
}

vars:pre-request {
  baseUrl: https://store.appguard.ai
  defaultEntity: versions
}

settings {
  encodeUrl: true
  timeout: 0
}
