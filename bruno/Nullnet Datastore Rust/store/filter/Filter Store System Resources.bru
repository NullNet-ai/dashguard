meta {
  name: Filter Store System Resources
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/store/system_resources/filter
  body: json
  auth: inherit
}

body:json {
  {
    "pluck": [
      "num_cpus",
      "global_cpu_usage",
      "cpu_usage",
      "total_memory",
      "used_memory",
      "total_disk_space",
      "available_disk_space",
      "read_bytes",
      "written_bytes",
      "temperature",
      "timestamp"
    ],
    "pluck_object": {},
    "pluck_group_object": {},
    "advance_filters": [
      {
        "type": "criteria",
        "field": "device_id",
        "entity": "system_resources",
        "operator": "equal",
        "values": [
          "01KW12JPKB3YND9FEX55DK9FQK"
        ]
      }
    ],
    "offset": 0,
    "limit": 60,
    "joins": [],
    "order_direction": "desc",
    "order_by": "system_resources.timestamp",
    "is_case_sensitive_sorting": false,
    "multiple_sort": [],
    "date_format": "mm/dd/YYYY",
    "concatenate_fields": [],
    "group_advance_filters": [],
    "distinct_by": "",
    "time_format": "HH24:MI"
  }
}

vars:pre-request {
  baseUrl: https://store.appguard.ai
  defaultEntity: versions
}

settings {
  encodeUrl: true
  timeout: 0
}
