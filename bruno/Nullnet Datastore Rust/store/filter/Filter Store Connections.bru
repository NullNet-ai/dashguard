meta {
  name: Filter Store Connections
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/store/root/connections/filter
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..ChoH4rh0PqDy0xArlfyrcyAXUNHEYQ8JrCknMNrlbcU
}

body:json {
  {
    "pluck": [
      "id",
      "status",
      "interface_name",
      "source_ip",
      "destination_ip",
      "timestamp",
      "protocol"
    ],
    "pluck_object": {},
    "pluck_group_object": {},
    "advance_filters": [
      {
        "type": "criteria",
        "field": "source_ip",
        "entity": "connections",
        "operator": "like",
        "values": [
          "192.168.0.251%"
        ],
        "parse_as": "text"
      },
      {
        "type": "operator",
        "operator": "and"
      },
      {
        "type": "criteria",
        "field": "device_id",
        "entity": "connections",
        "operator": "equal",
        "values": [
          "01KTMW9F9K6C4WB4QM5KMJ1RJ3"
        ]
      },
      {
        "type": "operator",
        "operator": "and"
      },
      {
        "type": "criteria",
        "field": "timestamp",
        "entity": "connections",
        "operator": "is_between",
        "values": [
          "2026-06-13 18:00:00+00",
          "2026-06-14 06:00:39+00"
        ]
      }
    ],
    "offset": 0,
    "limit": 20,
    "joins": [],
    "order_direction": "desc",
    "order_by": "connections.code",
    "is_case_sensitive_sorting": true,
    "multiple_sort": [],
    "date_format": "mm/dd/YYYY",
    "concatenate_fields": [],
    "group_advance_filters": [],
    "distinct_by": "",
    "time_format": "HH24:MI"
  }
}

vars:pre-request {
  baseUrl: https://store.appguard.ai
}

settings {
  encodeUrl: true
  timeout: 0
}
