          "to": {
            "alias": "updated_by_account_organizations",
            "entity": "account_organizations",
            "field": "id"
          },
          "from": {
            "entity": "devices",
            "field": "updated_by"
          }
        },
        "nested": false
      },
      {
        "type": "left",
        "field_relation": {
          "to": {
            "alias": "updated_by",
            "entity": "contacts",
            "field": "id"
          },
          "from": {
            "entity": "updated_by_account_organizations",
            "field": "contact_id"
          }
        },
        "nested": true
      }
    ],
    "order_direction": "desc",
    "order_by": "code",
    "is_case_sensitive_sorting": false,
    "multiple_sort": [],
    "date_format": "mm/dd/YYYY",
    "concatenate_fields": [
      {
        "fields": [
          "first_name",
          "last_name"
        ],
        "field_name": "full_name",
        "separator": " ",
        "entity": "contacts",
        "aliased_entity": "created_by"
      },
      {
        "fields": [
          "first_name",
          "last_name"
        ],
        "field_name": "full_name",
        "separator": " ",
        "entity": "contacts",
        "aliased_entity": "updated_by"
      },
      {
        "fields": [
          "created_date",
          "created_time"
        ],
        "field_name": "created_date_time",
        "separator": " ",
        "entity": "device"
      },
      {
        "fields": [
          "updated_date",
          "updated_time"
        ],
        "field_name": "updated_date_time",
        "separator": " ",
        "entity": "device"
      }
    ],
    "group_advance_filters": [],
    "distinct_by": "",
    "group_by": {},
    "time_format": "HH24:MI"
  }
  
