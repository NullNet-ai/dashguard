meta {
  name: Aggregate Store Data Connections
  type: http
  seq: 3
}

post {
  url: https://store.appguard.ai/api/store/root/aggregate
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..1fj4-_crBRpQp8Tkwdp93zVW3i8R5nIbYP76Y7vRVd8
}

body:json {
  {
    "advance_filters": [
      {
        "type": "criteria",
        "field": "timestamp",
        "entity": "connections",
        "operator": "is_between",
        "values": [
          "2026-06-23 13:53:00+00",
          "2026-06-23 13:54:20+00"
        ]
      },
      {
        "type": "operator",
        "operator": "and"
      },
      {
        "type": "criteria",
        "field": "source_ip",
        "entity": "connections",
        "operator": "equal",
        "values": [
          "3.230.105.35"
        ]
      },
      {
        "type": "operator",
        "operator": "and"
      },
      {
        "type": "criteria",
        "field": "device_id",
        "entity": "connections",
        "operator": "equal",
        "values": [
          "01KVS4X3V695AE267298XNVJZV"
        ]
      }
    ],
    "joins": [],
    "aggregations": [
      {
        "aggregation": "SUM",
        "aggregate_on": "total_byte",
        "bucket_name": "bandwidth"
      }
    ],
    "order": {
      "order_by": "bucket",
      "order_direction": "desc"
    },
    "bucket_size": "1s",
    "timezone": "Asia/Manila",
    "entity": "connections",
    "limit": 60
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
